<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/auth.css">
</head>

<body class="login-page">

    <%- include('partials/header') %>

    <div class="login-container">
        <h1>Login</h1>
        <form id="loginForm" novalidate>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" maxlength="255" autocomplete="email" required>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit">Login</button>
        </form>
        <p id="loginMessage" class="form-message" role="alert" aria-live="polite"></p>
        <div class="login-register-link">
            Still don't have an account? <a href="/register">Register here</a>
        </div>
    </div>

    <script src="/js/menu.js"></script>
    <script src="/js/login.js"></script>
</body>

</html>
