<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/auth.css">
</head>

<body class="register-page">

    <%- include('partials/header') %>

    <div class="register-container">
        <h1>Register</h1>
        <form id="registerForm" novalidate>
            <div class="form-group">
                <label for="firstName">First Name</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"></path>
                        </svg>
                    </span>
                    <input type="text" id="firstName" name="firstName" minlength="2" maxlength="100" autocomplete="given-name" required>
                </div>
            </div>
            <div class="form-group">
                <label for="lastName">Last Name</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"></path>
                        </svg>
                    </span>
                    <input type="text" id="lastName" name="lastName" minlength="2" maxlength="100" autocomplete="family-name" required>
                </div>
            </div>
            <div class="form-group">
                <label for="dateOfBirth">Date of Birth</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M7 2h2v2h6V2h2v2h3v18H4V4h3zm11 8H6v10h12V10z"></path>
                        </svg>
                    </span>
                    <input type="text" id="dateOfBirth" name="dateOfBirth" placeholder="DD.MM.YYYY" inputmode="numeric" pattern="[0-9]{2}\.[0-9]{2}\.[0-9]{4}" maxlength="10" title="Use DD.MM.YYYY format" autocomplete="bday" required>
                </div>
            </div>
            <div class="form-group">
                <label for="country">Country</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm7.93 9h-3.07a15.7 15.7 0 0 0-1.14-5A8.03 8.03 0 0 1 19.93 11zM12 4a13.7 13.7 0 0 1 2.84 7H9.16A13.7 13.7 0 0 1 12 4zM8.28 6a15.7 15.7 0 0 0-1.14 5H4.07A8.03 8.03 0 0 1 8.28 6zM4.07 13h3.07a15.7 15.7 0 0 0 1.14 5A8.03 8.03 0 0 1 4.07 13zM12 20a13.7 13.7 0 0 1-2.84-7h5.68A13.7 13.7 0 0 1 12 20zm3.72-2a15.7 15.7 0 0 0 1.14-5h3.07A8.03 8.03 0 0 1 15.72 18z"></path>
                        </svg>
                    </span>
                    <select id="country" name="country" autocomplete="country-name" required>
                        <option value="" selected disabled>Loading countries...</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5L4 8V6l8 5 8-5z"></path>
                        </svg>
                    </span>
                    <input type="email" id="email" name="email" maxlength="255" autocomplete="email" required>
                </div>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4z"></path>
                        </svg>
                    </span>
                    <input type="password" id="password" name="password" minlength="12" pattern="(?=.*\d).{12,}" title="Password must be at least 12 characters and contain at least one digit" autocomplete="new-password" required>
                    <button type="button" class="password-toggle" aria-label="Toggle password visibility" data-target="password">
                        <img src="/images/show_password.svg" alt="" class="icon-show">
                        <img src="/images/hide_password.svg" alt="" class="icon-hide">
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label for="confirm">Confirm Password</label>
                <div class="input-with-icon">
                    <span class="input-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4z"></path>
                        </svg>
                    </span>
                    <input type="password" id="confirm" name="confirm" minlength="12" autocomplete="new-password" required>
                    <button type="button" class="password-toggle" aria-label="Toggle password visibility" data-target="confirm">
                        <img src="/images/show_password.svg" alt="" class="icon-show">
                        <img src="/images/hide_password.svg" alt="" class="icon-hide">
                    </button>
                </div>
            </div>
            <button type="submit">Register</button>
        </form>
        <p id="registerMessage" class="form-message" role="alert" aria-live="polite"></p>
        <div class="login-register-link">
            Already have an account? <a href="/login">Login here</a>
        </div>
    </div>

    <script src="/js/menu.js"></script>
    <script src="/js/register.js"></script>
</body>

</html>
