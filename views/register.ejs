<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/auth.css">
</head>

<body class="register-page">

    <%- include('partials/header') %>

    <div class="register-container">
        <h1>Register</h1>
        
        <form id="registerForm" novalidate>
            <div class="reg-layout">
                
                <div class="reg-tabs">
                    <button type="button" class="reg-tab-btn active" data-target="panel-name">
                        <span class="tab-name">Full Name</span> <span class="status-dot"></span>
                    </button>
                    <button type="button" class="reg-tab-btn" data-target="panel-dob">
                        <span class="tab-name">Date of Birth</span> <span class="status-dot"></span>
                    </button>
                    <button type="button" class="reg-tab-btn" data-target="panel-country">
                        <span class="tab-name">Country</span> <span class="status-dot"></span>
                    </button>
                    <button type="button" class="reg-tab-btn" data-target="panel-email">
                        <span class="tab-name">Email</span> <span class="status-dot"></span>
                    </button>
                    <button type="button" class="reg-tab-btn" data-target="panel-password">
                        <span class="tab-name">Password</span> <span class="status-dot"></span>
                    </button>
                </div>

                <div class="reg-panels">
                    
                    <div id="panel-name" class="reg-panel active">
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div class="form-group">
                                <label for="firstName">First Name</label>
                                <div class="input-with-icon">
                                    <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"></path></svg></span>
                                    <input type="text" id="firstName" name="firstName" minlength="2" maxlength="100" autocomplete="given-name" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="lastName">Last Name</label>
                                <div class="input-with-icon">
                                    <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"></path></svg></span>
                                    <input type="text" id="lastName" name="lastName" minlength="2" maxlength="100" autocomplete="family-name" required>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="next-btn" onclick="nextTab('panel-dob')">Next Step ➜</button>
                    </div>

                    <div id="panel-dob" class="reg-panel">
                        <div class="form-group">
                            <label for="dateOfBirth">Date of Birth</label>
                            <div class="input-with-icon">
                                <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 2h2v2h6V2h2v2h3v18H4V4h3zm11 8H6v10h12V10z"></path></svg></span>
                                <input type="text" id="dateOfBirth" name="dateOfBirth" placeholder="DD.MM.YYYY" inputmode="numeric" pattern="[0-9]{2}\.[0-9]{2}\.[0-9]{4}" maxlength="10" title="Use DD.MM.YYYY format" autocomplete="bday" required>
                            </div>
                        </div>
                        <button type="button" class="next-btn" onclick="nextTab('panel-country')">Next Step ➜</button>
                    </div>

                    <div id="panel-country" class="reg-panel">
                        <div class="form-group">
                            <label for="country">Country</label>
                            <div class="input-with-icon">
                                <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm7.93 9h-3.07a15.7 15.7 0 0 0-1.14-5A8.03 8.03 0 0 1 19.93 11zM12 4a13.7 13.7 0 0 1 2.84 7H9.16A13.7 13.7 0 0 1 12 4zM8.28 6a15.7 15.7 0 0 0-1.14 5H4.07A8.03 8.03 0 0 1 8.28 6zM4.07 13h3.07a15.7 15.7 0 0 0 1.14 5A8.03 8.03 0 0 1 4.07 13zM12 20a13.7 13.7 0 0 1-2.84-7h5.68A13.7 13.7 0 0 1 12 20zm3.72-2a15.7 15.7 0 0 0 1.14-5h3.07A8.03 8.03 0 0 1 15.72 18z"></path></svg></span>
                                <select id="country" name="country" autocomplete="country-name" required>
                                    <option value="" selected disabled>Loading countries...</option>
                                    <option value="UA">Ukraine</option>
                                    <option value="US">United States</option>
                                </select>
                            </div>
                        </div>
                        <button type="button" class="next-btn" onclick="nextTab('panel-email')">Next Step ➜</button>
                    </div>

                    <div id="panel-email" class="reg-panel">
                        <div class="form-group">
                            <label for="email">Email</label>
                            <div class="input-with-icon">
                                <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5L4 8V6l8 5 8-5z"></path></svg></span>
                                <input type="email" id="email" name="email" maxlength="255" autocomplete="email" placeholder="example@gmail.com" required>
                            </div>
                        </div>
                        <button type="button" class="next-btn" onclick="nextTab('panel-password')">Next Step ➜</button>
                    </div>

                    <div id="panel-password" class="reg-panel">
                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <div class="form-group">
                                <label for="password">Create a Password</label>
                                <div class="input-with-icon">
                                    <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4z"></path></svg></span>
                                    <input type="password" id="password" name="password" minlength="12" pattern="(?=.*\d).{12,}" title="Minimum 12 characters and 1 digit" autocomplete="new-password" placeholder="••••••••••••" required>
                                    <button type="button" class="password-toggle" aria-label="Toggle password visibility" data-target="password">
                                        <img src="/images/show_password.svg" alt="" class="icon-show">
                                        <img src="/images/hide_password.svg" alt="" class="icon-hide">
                                    </button>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="confirm">Confirm Password</label>
                                <div class="input-with-icon">
                                    <span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4z"></path></svg></span>
                                    <input type="password" id="confirm" name="confirm" minlength="12" autocomplete="new-password" placeholder="••••••••••••" required>
                                    <button type="button" class="password-toggle" aria-label="Toggle password visibility" data-target="confirm">
                                        <img src="/images/show_password.svg" alt="" class="icon-show">
                                        <img src="/images/hide_password.svg" alt="" class="icon-hide">
                                    </button>
                                </div>
                            </div>
                        </div>
                        <button type="submit" id="finalSubmitBtn" class="final-btn next-btn" disabled>Complete Registration</button>
                    </div>

                </div>
            </div>
        </form>
        
        <p id="registerMessage" class="form-message" role="alert" aria-live="polite"></p>
        <div class="login-register-link">
            Already have an account? <a href="/login">Login here</a>
        </div>
    </div>

    <script src="/js/menu.js"></script>
    <script src="/js/register.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = document.querySelectorAll('.reg-tab-btn');
            const panels = document.querySelectorAll('.reg-panel');
            const inputs = document.querySelectorAll('.reg-panel input, .reg-panel select');
            const finalBtn = document.getElementById('finalSubmitBtn');

            // Перемикання вкладок
            window.nextTab = function(targetId) {
                tabs.forEach(t => t.classList.remove('active'));
                panels.forEach(p => p.classList.remove('active'));
                
                const targetTab = document.querySelector(`.reg-tab-btn[data-target="${targetId}"]`);
                const targetPanel = document.getElementById(targetId);
                
                if(targetTab && targetPanel) {
                    targetTab.classList.add('active');
                    targetPanel.classList.add('active');
                }
            };

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    nextTab(tab.dataset.target);
                });
            });

            function validateInput(input) {
                const panel = input.closest('.reg-panel');
                const tab = document.querySelector(`.reg-tab-btn[data-target="${panel.id}"]`);
                
                // 1. Кастомна перевірка співпадіння паролів
                if(input.id === 'confirm' || input.id === 'password') {
                    const pwd = document.getElementById('password').value;
                    const confInput = document.getElementById('confirm');
                    if(confInput.value !== pwd && confInput.value !== '') {
                        confInput.setCustomValidity("Passwords don't match");
                    } else {
                        confInput.setCustomValidity("");
                    }
                }

                const panelInputs = panel.querySelectorAll('input, select');
                let isPanelEmpty = true;
                let isPanelValid = true;

                panelInputs.forEach(inp => {
                    if (inp.value.trim() !== '') isPanelEmpty = false; 
                    if (!inp.checkValidity() || inp.value.trim() === '') isPanelValid = false;
                });

                if (isPanelEmpty) {
                    tab.classList.remove('is-valid', 'is-invalid');
                    panel.classList.remove('is-valid', 'is-invalid');
                } else if (isPanelValid) {
                    // Якщо ВСІ поля в панелі ідеальні
                    tab.classList.remove('is-invalid');
                    tab.classList.add('is-valid');
                    panel.classList.remove('is-invalid');
                    panel.classList.add('is-valid');
                } else {
                    // Якщо є помилка хоча б в одному полі
                    tab.classList.remove('is-valid');
                    tab.classList.add('is-invalid');
                    panel.classList.remove('is-valid');
                    panel.classList.add('is-invalid');
                }
                
                checkAllValid();
            }

            function checkAllValid() {
                const allValid = Array.from(inputs).every(inp => inp.checkValidity() && inp.value.trim() !== '');
                if (allValid) {
                    finalBtn.disabled = false;
                    finalBtn.style.opacity = '1';
                } else {
                    finalBtn.disabled = true;
                    finalBtn.style.opacity = '0.5';
                }
            }

            inputs.forEach(input => {
                input.addEventListener('input', () => validateInput(input));
                input.addEventListener('change', () => validateInput(input));
            });
        });
    </script>
</body>
</html>