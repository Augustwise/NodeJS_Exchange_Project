<header>
    <a href="/" class="name">
        <svg class="logo-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        CurrencyChecker
    </a>
    <nav id="mainNav" class="main-nav">
        <ul>
            <li><a href="/"       class="<%= activePage === 'home'    ? 'active' : '' %>">Home</a></li>
            <li><a href="/crypt"  class="<%= activePage === 'crypt'   ? 'active' : '' %>">Crypto</a></li>
            <li><a href="/about"  class="<%= activePage === 'about'   ? 'active' : '' %>">About</a></li>
            <li><a href="/contact" class="<%= activePage === 'contact' ? 'active' : '' %>">Contact</a></li>
            <% if (currentUser && currentUser.isAdmin) { %>
                <li><a href="/admin" class="<%= activePage === 'admin' || activePage === 'admin-users' || activePage === 'admin-cryptos' ? 'active' : '' %>">Admin</a></li>
            <% } %>
            <% if (currentUser) { %>
                <li class="mobile-auth-item"><a href="/account" class="<%= activePage === 'account' ? 'active' : '' %>">Account</a></li>
            <% } else { %>
                <li class="mobile-auth-item mobile-auth-links">
                    <a href="/login">Log In</a>
                    <a href="/register">Sign Up</a>
                </li>
            <% } %>
        </ul>
    </nav>
    <div class="logInButtons">
        <% if (currentUser) { %>
            <% if (currentUser.isAdmin) { %>
                <a href="/admin" class="btn btn-text">Admin</a>
            <% } %>
            <a href="/account" class="btn btn-primary">Account</a>
        <% } else { %>
            <a href="/login" class="btn btn-text">Log In</a>
            <a href="/register" class="btn btn-primary">Sign Up</a>
        <% } %>
    </div>
    <button id="menuToggle" class="menu-toggle" type="button" aria-label="Toggle navigation menu" aria-controls="mainNav" aria-expanded="false">
        <img src="/images/burger_menu.svg" alt="" class="menu-icon icon-open">
        <img src="/images/close.svg" alt="" class="menu-icon icon-close">
    </button>
</header>
<div id="menuOverlay" class="menu-overlay"></div>

