<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Users</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/admin.css">
</head>

<body class="admin-users-page">
    <%- include('partials/header') %>

    <main class="admin-main">
        <section class="admin-card admin-users-card">
            <div class="admin-users-top">
                <div>
                    <h1>Users Management</h1>
                    <p class="admin-subtitle">Grant or revoke the <strong>Admin</strong> role.</p>
                </div>
                <a href="/admin" class="btn btn-text">Back to Admin</a>
            </div>

            <% if (feedback) { %>
                <div class="admin-alert admin-alert-success"><%= feedback %></div>
            <% } %>
            <% if (error) { %>
                <div class="admin-alert admin-alert-error"><%= error %></div>
            <% } %>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(user) { %>
                            <tr>
                                <td data-label="ID"><%= user.id %></td>
                                <td data-label="Name"><%= user.name %> <%= user.surname %></td>
                                <td data-label="Email"><%= user.email %></td>
                                <td data-label="Roles">
                                    <% if (user.roleNames.length === 0) { %>
                                        <span class="role-pill role-default">No role</span>
                                    <% } else { %>
                                        <% user.roleNames.forEach(function(roleName) { %>
                                            <span class="role-pill <%= roleName === 'Admin' ? 'role-admin' : 'role-default' %>"><%= roleName %></span>
                                        <% }); %>
                                    <% } %>
                                </td>
                                <td data-label="Action">
                                    <% if (user.isAdmin) { %>
                                        <% if (user.id === currentAdminId) { %>
                                            <span class="self-label">Current admin</span>
                                        <% } else { %>
                                            <form action="/admin/users/<%= user.id %>/revoke-admin" method="post">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-danger">Remove Admin</button>
                                            </form>
                                        <% } %>
                                    <% } else { %>
                                        <form action="/admin/users/<%= user.id %>/grant-admin" method="post">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-primary">Make Admin</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script src="/js/menu.js"></script>
</body>

</html>

