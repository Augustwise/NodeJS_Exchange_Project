<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Currency</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/home.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <% const serializedRates = JSON.stringify(locals.rates || {}).replace(/</g, '\\u003c'); %>
    <% const serializedHistory = JSON.stringify(locals.history || {}).replace(/</g, '\\u003c'); %>
    <script id="server-rates-data" type="application/json"><%- serializedRates %></script>
    <script id="server-history-data" type="application/json"><%- serializedHistory %></script>
    <script>
    function parseServerJson(elementId) {
        const el = document.getElementById(elementId);

        if (!el) {
            return {};
        }

        try {
            return JSON.parse(el.textContent || '{}');
        } catch (error) {
            console.warn(`Failed to parse server JSON from ${elementId}`, error);
            return {};
        }
    }

    // Assign to window (global scope) so chart and converter scripts can access them.
    window.SERVER_RATES = parseServerJson('server-rates-data');
    window.SERVER_HISTORY = parseServerJson('server-history-data');
    
    console.log('Template: SERVER_RATES loaded with', Object.keys(window.SERVER_RATES || {}).length, 'currencies');
    console.log('Template: SERVER_HISTORY loaded with', Object.keys(window.SERVER_HISTORY || {}).length, 'currencies');
    </script>
</head>

<body class="home-page">

    <%- include('partials/header') %>

    <main>
        <div class="hero-section">
            <div class="leftPart">
                <div class="chart-wrapper">
                    <div class="chart-header-row">
                        <div class="chart-title-group">
                            <div class="select-wrapper">
                                <div id="chartCurrencyLabel">Loading...</div>
                            </div>

                            <div class="price-info">
                                <h2 id="currentRate">Loading...</h2>
                                <p id="rateChange" class="rate-change positive">
                                    Loading... <span class="time-label">(today)</span>
                                </p>
                            </div>
                        </div>

                        <div class="time-controls">
                            <button class="time-btn active" onclick="updateTimePeriod('1D')">1D</button>
                            <button class="time-btn" onclick="updateTimePeriod('1W')">1W</button>
                            <button class="time-btn" onclick="updateTimePeriod('1M')">1M</button>
                        </div>
                    </div>
                    <div class="canvas-container">
                        <canvas id="currencyChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="rightPart">
                <div class="converter-card">
                    <div class="converter-header">Quick currency converter</div>

                    <div class="input-group">
                        <input type="number" id="amount-one" value="1" min="0"> 
                        <select class="currency-select" id="currency-one">
                            <% const keys = Object.keys(locals.rates || {}).sort();
                               keys.forEach(function(k){ %>
                                <option value="<%= k %>" <%= k === 'USD' ? 'selected' : '' %>><%= k %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div id="rate" ></div>

                    <div class="input-group">
                        <input type="number" id="amount-two" value="0" min="0">
                        <select class="currency-select" id="currency-two">
                            <% keys.forEach(function(k){ %>
                                <option value="<%= k %>" <%= k === 'UAH' ? 'selected' : '' %>><%= k %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_of_the_United_States.svg" alt="USD Flag">
                    <h3>USD</h3>
                </div>
                <div class="stat-value" id="widget-usd">
                    <%= locals.rates && locals.rates['USD'] ? Number(locals.rates['USD']).toFixed(2) : 'N/A' %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_of_Europe.svg" alt="EUR Flag">
                    <h3>EUR</h3>
                </div>
                <div class="stat-value" id="widget-eur">
                    <%= locals.rates && locals.rates['EUR'] ? Number(locals.rates['EUR']).toFixed(2) : 'N/A' %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_of_Japan.svg" alt="JPY Flag">
                    <h3>JPY</h3>
                </div>
                <div class="stat-value" id="widget-jpy">
                    <%= locals.rates && locals.rates['JPY'] ? Number(locals.rates['JPY']).toFixed(2) : 'N/A' %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_of_the_UK.svg" alt="GBP Flag">
                    <h3>GBP</h3>
                </div>
                <div class="stat-value" id="widget-gbp">
                    <%= locals.rates && locals.rates['GBP'] ? Number(locals.rates['GBP']).toFixed(2) : 'N/A' %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_of_Switzerland.svg" alt="CHF Flag">
                    <h3>CHF</h3>
                </div>
                <div class="stat-value" id="widget-chf">
                    <%= locals.rates && locals.rates['CHF'] ? Number(locals.rates['CHF']).toFixed(2) : 'N/A' %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_China.svg" alt="CNY Flag">
                    <h3>CNY</h3>
                </div>
                <div class="stat-value" id="widget-cny">
                    <%= locals.rates && locals.rates['CNY'] ? Number(locals.rates['CNY']).toFixed(2) : 'N/A' %>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/index.js"></script>
    <script src="/js/menu.js"></script>
    <script src="/js/converter.js"></script>

    <script>

function updateValueWithFlash(elementId, newValue) {
    const el = document.getElementById(elementId);
    if (!el) return;

    if (el.innerText !== String(newValue)) {
        el.innerText = newValue;

        const animClass = (elementId === 'currentRate') ? 'flash-update' : 'flash-update-normal';
        
        el.classList.remove(animClass);
        void el.offsetWidth; 
        el.classList.add(animClass);
    }
}
    </script>
</body>
</html>
