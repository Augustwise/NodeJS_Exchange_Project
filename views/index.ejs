<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Currency</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const SERVER_RATES = <%- JSON.stringify(locals.rates || {}) %>;
    </script>
</head>

<body>

    <%- include('partials/header') %>

    <main>
        <div class="hero-section">
            <div class="leftPart">
                <div class="chart-wrapper">
                    <div class="chart-header-row">
                        <div class="chart-title-group">
                            <div class="select-wrapper">
                                <select id="chartCurrencySelect" onchange="changeCurrency(this.value)">
                                    <option value="USD">USD / UAH</option>
                                    <option value="EUR">EUR / UAH</option>
                                    <option value="GBP">GBP / UAH</option>
                                    <option value="BTC">BTC / USD</option>
                                </select>
                                <span class="custom-arrow">▼</span>
                            </div>

                            <div class="price-info">
                                <h2 id="currentRate">41.50</h2>
                                <p id="rateChange" class="rate-change positive">
                                    +0.45% <span class="time-label">(today)</span>
                                </p>
                            </div>
                        </div>

                        <div class="time-controls">
                            <button class="time-btn active" onclick="updateTimePeriod('1D')">1D</button>
                            <button class="time-btn" onclick="updateTimePeriod('1W')">1W</button>
                            <button class="time-btn" onclick="updateTimePeriod('1M')">1M</button>
                        </div>
                    </div>
                    <div class="canvas-container">
                        <canvas id="currencyChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="rightPart">
                <div class="converter-card">
                    <div class="converter-header">Quick currency converter</div>

                    <div class="input-group">
                        <input type="number" id="amount-one" value="1" min="0"> 
                        <select class="currency-select" id="currency-one">
                            <option value="USD" selected>USD</option>
                            <option value="UAH">UAH</option>
                            <option value="EUR">EUR</option>
                            <option value="GBP">GBP</option>
                            <option value="PLN">PLN</option>
                            <option value="JPY">JPY</option>
                            <option value="CNY">CNY</option>
                            <option value="CAD">CAD</option>
                            <option value="AUD">AUD</option>
                        </select>
                    </div>

                    <div id="rate" style="text-align: center; margin: 10px 0; color: #888; font-size: 14px;"></div>

                    <div class="input-group">
                        <input type="number" id="amount-two" value="0" min="0">
                        <select class="currency-select" id="currency-two">
                            <option value="UAH" selected>UAH</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                            <option value="GBP">GBP</option>
                            <option value="PLN">PLN</option>
                            <option value="JPY">JPY</option>
                            <option value="CNY">CNY</option>
                            <option value="CAD">CAD</option>
                            <option value="AUD">AUD</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_of_Europe.webp" alt="">
                    <h3>EUR</h3>
                </div>
                <div class="stat-value">43.92</div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_UK.webp" alt="">
                    <h3>GBP</h3>
                </div>
                <div class="stat-value">52.18</div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <img src="/images/Flag_China.svg" alt="">
                    <h3>CHF</h3>
                </div>
                <div class="stat-value">46.75</div>
            </div>
        </div>
    </main>

    <script src="/js/index.js"></script>
    <script src="/js/menu.js"></script>
    <script src="/js/converter.js"></script>
</body>

</html>
