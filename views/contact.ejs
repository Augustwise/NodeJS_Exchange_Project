        <div class="floating-icon icon-right">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        </div>

        <main class="contact-main">
            <div class="contact-grid">
                
                <div class="contact-info">
                    <h1>Get in Touch</h1>
                    <p>
                        Have a question about our exchange rates, need API support, or just want to report a bug? 
                        Drop us a message and our team will get back to you as soon as possible.
                    </p>
                    
                    <div class="info-blocks">
                        <div class="info-item">
                            <span class="info-label">Support Email</span>
                            <a href="mailto:support@currencychecker.com" class="info-value">support@currencychecker.com</a>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Community</span>
                            <a href="https://discord.gg/CTN362ZSuf" target="_blank" rel="noopener noreferrer" class="info-value">Join our Discord</a>
                        </div>
                    </div>
                </div>

                <form class="contact-form" action="#" method="POST">
                    <div class="input-group">
                        <label for="name">Your Name</label>
                        <input type="text" id="name" name="name" placeholder="Gus Bogdan" required>
                    </div>
                    
                    <div class="input-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="gus@gmail.com" required>
                    </div>
                    
                    <div class="input-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="4" placeholder="How can we help you?" required></textarea>
                    </div>
                    
                    <button type="submit" class="submit-btn">Send Message</button>
                </form>

            </div>
        </main>
    </div>

    <script src="/js/menu.js"></script>
</body>

</html>