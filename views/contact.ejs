<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact — CurrencyChecker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/contact.css">
</head>

<body class="contact-page">

    <%- include('partials/header') %>

    <div class="contact-wrapper">

        <div class="floating-icon icon-left">
            <img src="/images/contact-discord.svg" alt="" aria-hidden="true">
        </div>

        <div class="floating-icon icon-top-right">
            <img src="/images/contact-envelope.svg" alt="" aria-hidden="true">
        </div>

        <div class="floating-icon icon-right">
            <img src="/images/contact-send.svg" alt="" aria-hidden="true">
        </div>

        <main class="contact-main">
            <div class="contact-grid">
                
                <div class="contact-info">
                    <h1>Get in Touch</h1>
                    <p>
                        Have a question about our exchange rates, need API support, or just want to report a bug? 
                        Drop us a message and our team will get back to you as soon as possible.
                    </p>
                    
                    <div class="info-blocks">
                        <div class="info-item">
                            <span class="info-label">Support Email</span>
                            <a href="mailto:support@currencychecker.com" class="info-value">support@currencychecker.com</a>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Community</span>
                            <a href="https://discord.gg/CTN362ZSuf" target="_blank" rel="noopener noreferrer" class="info-value">Join our Discord</a>
                        </div>
                    </div>
                </div>

                <form class="contact-form" action="#" method="POST">
                    <div class="input-group">
                        <label for="name">Your Name</label>
                        <input type="text" id="name" name="name" placeholder="Gus Bogdan" required>
                    </div>
                    
                    <div class="input-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="gus@gmail.com" required>
                    </div>
                    
                    <div class="input-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="4" placeholder="How can we help you?" required></textarea>
                    </div>
                    
                    <button type="submit" class="submit-btn">Send Message</button>
                </form>

            </div>
        </main>
    </div>

    <script src="/js/menu.js"></script>
</body>

</html>
