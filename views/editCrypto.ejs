<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= crypto.cryptoName %> — CurrencyChecker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/crypto.css">
</head>

<body class="crypto-page">

    <%- include('partials/header') %>

    <main>        
        <div class="stat-card" style="max-width: 500px; margin: 40px auto; padding: 40px;">
            <h2 style="text-align: center; margin-bottom: 25px; color: var(--text-main);">
                Edit Cryptocurrency
            </h2>
            
            <form action="/crypto/<%= crypto.id %>/edit" method="POST" class="add-form" style="margin: 0 auto;">
                <label for="cryptoName" style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: -5px;">Project Name:</label>
                
                <input type="text" id="cryptoName" name="cryptoName" value="<%= crypto.cryptoName %>" required>
                
                <button type="submit" style="margin-top: 15px;">Save Changes</button>
                
                <a href="/crypt" style="color: var(--text-muted); text-align: center; text-decoration: none; margin-top: 15px; transition: 0.3s;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-muted)'">
                    Cancel and go back
                </a>
            </form>
        </div>
    </main>

    <script src="/js/menu.js"></script>
</body>

</html>