<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crypto — CurrencyChecker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/crypto.css">
 
</head>

<body class="crypto-page">

    <%- include('partials/header') %>

    <%
        const chartOptions = [
            { symbol: 'BINANCE:BTCUSDT' },
            { symbol: 'BINANCE:ETHUSDT' },
            { symbol: 'BINANCE:SOLUSDT' },
            { symbol: 'BINANCE:ADAUSDT' },
            { symbol: 'BINANCE:BNBUSDT' },
            { symbol: 'BINANCE:XRPUSDT' },
            { symbol: 'BINANCE:TONUSDT' },
            { symbol: 'BINANCE:DOGEUSDT' },
            { symbol: 'BINANCE:PEPEUSDT' }
        ];
        const approvedCharts = (cryptos || [])
            .filter((coin) => coin.isApproved)
            .map((coin, index) => ({ coin, chart: chartOptions[index % chartOptions.length] }));
        const currentUserId = currentUser ? currentUser.id : null;
        const myCoins = cryptos ? cryptos.filter((coin) => coin.creator == currentUserId) : [];
    %>

    <main>        
        <div class="tabs-header">
            <button class="tab-btn active" onclick="switchMainTab(event, 'public-crypto')">Public Projects</button>
            <button class="tab-btn" onclick="switchMainTab(event, 'users-crypto')">Users Projects</button>
            <button class="tab-btn-right" onclick="switchMainTab(event, 'my-crypto')">My Projects</button>
        </div>

        <tv-ticker-tape symbols='FOREXCOM:SPXUSD,FOREXCOM:NSXUSD,FOREXCOM:DJI,FX:EURUSD,BITSTAMP:BTCUSD,BITSTAMP:ETHUSD' theme="dark"></tv-ticker-tape>

        <div id="users-crypto" class="tab-content">
            <div class="crypto-layout">
                <div class="crypto-list">
                    <% if (approvedCharts.length > 0) { %>
                        <% approvedCharts.forEach(function(entry, index) { %>
                            <button
                                class="coin-btn <%= index === 0 ? 'active' : '' %>"
                                data-chart-container="users-chart"
                                data-symbol="<%= entry.chart.symbol %>"
                                onclick="switchChart(event)">
                                <span class="coin-name"><%= entry.coin.cryptoName %></span>
                                <span class="coin-ticker"><%= entry.coin.cryptoName.substring(0, 3).toUpperCase() %></span>
                            </button>
                        <% }); %>
                    <% } else { %>
                        <p style="color: var(--text-muted); text-align: center; padding: 20px;">No approved projects yet.</p>
                    <% } %>
                </div>
        
                <% if (approvedCharts.length > 0) { %>
                    <div class="chart-wrapper">
                        <div id="users-chart" class="tv-chart-host"></div>
                    </div>
                <% } %>
        
            </div>
        </div>

        <div id="my-crypto" class="tab-content">
            <% if (currentUser) { %>
                <a href="/create" class="btn btn-primary" style="margin-bottom: 20px; display: inline-block;">Create</a>
                <div class="crypto-list">
                    <% if (myCoins.length > 0) { %>
                        
                        <% myCoins.forEach(function(coin) { %>
                            <div class="coin-btn" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding: 10px; border: 1px solid var(--border-color); border-radius: 8px;">
                                
                                <div class="coin-info">
                                    <span class="coin-name" style="font-weight: bold; margin-right: 10px;"><%= coin.cryptoName %></span>
                                    <span class="coin-ticker">
                                        <% if (coin.isApproved) { %>
                                            <span style="color: var(--primary-accent);">Approved</span>
                                        <% } else { %>
                                            <span style="color: var(--text-muted);">Pending</span>
                                        <% } %>
                                    </span>
                                </div>
        
                                <div class="coin-actions">
                                    <a href="/crypto/<%= coin.id %>/edit" class="btn" style="background-color: #f0ad4e; color: white; padding: 5px 10px; text-decoration: none; border-radius: 4px; margin-right: 5px;">Edit</a>
                                    
                                    <form action="/crypto/<%= coin.id %>/delete" method="POST" style="display: inline-block; margin: 0;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn" style="background-color: #d9534f; color: white; padding: 5px 10px; border: none; border-radius: 4px; cursor: pointer;">Delete</button>
                                    </form>
                                </div>
        
                            </div>
                        <% }); %>
                
                    <% } else { %>
                        <p style="color: var(--text-muted); text-align: center;">You haven't added any cryptocurrencies yet.</p>
                    <% } %>
                </div>
            <% } else { %>
                <div class="stat-card" style="padding: 25px;">
                    <p style="color: var(--text-muted);">You need to create an account first</p>
                </div>
            <% } %>
        </div>

        <div id="public-crypto" class="tab-content active">
            <div class="crypto-layout">
                
                <div class="crypto-list">
                    <button class="coin-btn active" data-chart-container="public-chart" data-symbol="BINANCE:BTCUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Bitcoin</span> <span class="coin-ticker">BTC</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:ETHUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Ethereum</span> <span class="coin-ticker">ETH</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:SOLUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Solana</span> <span class="coin-ticker">SOL</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:ADAUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Cardano</span> <span class="coin-ticker">ADA</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:BNBUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Binance Coin</span> <span class="coin-ticker">BNB</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:XRPUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Ripple</span> <span class="coin-ticker">XRP</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:TONUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Toncoin</span> <span class="coin-ticker">TON</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:DOGEUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Dogecoin</span> <span class="coin-ticker">DOGE</span>
                    </button>
                    <button class="coin-btn" data-chart-container="public-chart" data-symbol="BINANCE:PEPEUSDT" onclick="switchChart(event)">
                        <span class="coin-name">Pepe</span> <span class="coin-ticker">PEPE</span>
                    </button>
                </div>

                <div class="chart-wrapper">
                    <div id="public-chart" class="tv-chart-host"></div>
                </div>

            </div>
        </div>
    </main>

    <script defer src="/js/menu.js"></script>
    <script type="module" src="https://widgets.tradingview-widget.com/w/en/tv-ticker-tape.js"></script>
    <script defer type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
    <script defer src="/js/crypt.js"></script>
</body>

</html>
